# Place this file (named exactly ".htaccess") inside:
#   config/.htaccess
#   includes/.htaccess
#   storage/.htaccess
#
# It blocks direct web requests to these folders while your PHP code
# can still require()/include() the files internally without any problem.

# Apache 2.4+
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2 fallback (older XAMPP versions)
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
